# THERMALIS-X Environment Configuration Template
APP_NAME=THERMALIS-X
APP_VERSION=1.0.0
DEBUG=False
DEMO_MODE=True
REAL_DATA_MODE=False

# NASA FIRMS API Credentials
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api
FIRMS_MAP_KEY=YOUR_NASA_FIRMS_MAP_KEY_HERE

# Element84 STAC AWS Registry
STAC_API_URL=https://earth-search.aws.element84.com/v1

# Open-Meteo Weather API
WEATHER_BASE_URL=https://api.open-meteo.com/v1

# Database Configuration (PostGIS / SQLite)
DATABASE_URL=sqlite:///./thermalis.db
# DATABASE_URL=postgresql://thermalis_user:thermalis_password@localhost:5432/thermalis_db

# Security & Authentication
SECRET_KEY=generate_a_secure_random_256_bit_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
