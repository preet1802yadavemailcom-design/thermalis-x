{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "1.0.0",
  "contract_name": "THERMALIS_FEATURE_SCHEMA_V1",
  "description": "Immutable feature contract for THERMALIS-X. Enforces exact feature ordering, physical units, sources, and leakage status across training and inference.",
  "feature_count": 16,
  "features": [
    {
      "index": 0,
      "name": "frp_mean",
      "dtype": "float64",
      "units": "MW",
      "source": "NASA FIRMS (VIIRS/MODIS)",
      "formula": "mean(frp_observations_in_event)",
      "availability": "event_formation",
      "imputation_strategy": "median",
      "default_imputed_value": 15.0,
      "leakage_status": "LEAKAGE_FREE"
    },
    {
      "index": 1,
      "name": "frp_max",
      "dtype": "float64",
      "units": "MW",
      "source": "NASA FIRMS (VIIRS/MODIS)",
      "formula": "max(frp_observations_in_event)",
      "availability": "event_formation",
      "imputation_strategy": "median",
      "default_imputed_value": 20.0,
      "leakage_status": "LEAKAGE_FREE"
    },
    {
      "index": 2,
      "name": "frp_trend",
      "dtype": "float64",
      "units": "MW/hour",
      "source": "NASA FIRMS (VIIRS/MODIS)",
      "formula": "linear_slope(frp_observations, acq_time)",
      "availability": "event_formation",
      "imputation_strategy": "constant_zero",
      "default_imputed_value": 0.0,
      "leakage_status": "LEAKAGE_FREE"
    },
    {
      "index": 3,
      "name": "dist_to_facility_km",
      "dtype": "float64",
      "units": "km",
      "source": "OSM / GEM / PostGIS",
      "formula": "geodesic_distance(event_centroid, nearest_facility_boundary)",
      "availability": "spatial_join",
      "imputation_strategy": "large_constant",
      "default_imputed_value": 999.0,
      "leakage_status": "LEAKAGE_FREE"
    },
    {
      "index": 4,
      "name": "is_near_facility",
      "dtype": "float64",
      "units": "binary_indicator",
      "source": "OSM / GEM / PostGIS",
      "formula": "1.0 if dist_to_facility_km <= 2.0 else 0.0",
      "availability": "spatial_join",
      "imputation_strategy": "constant_zero",
      "default_imputed_value": 0.0,
      "leakage_status": "LEAKAGE_FREE"
    },
    {
      "index": 5,
      "name": "area_ha",
      "dtype": "float64",
      "units": "hectares",
      "source": "Event Engine Convex Hull",
      "formula": "planar_or_geodesic_polygon_area(convex_hull) * 100",
      "availability": "event_formation",
      "imputation_strategy": "median",
      "default_imputed_value": 1.0,
      "leakage_status": "LEAKAGE_FREE"
    },
    {
      "index": 6,
      "name": "duration_hours",
      "dtype": "float64",
      "units": "hours",
      "source": "Event Engine Timestamps",
      "formula": "(last_seen - first_seen).total_seconds() / 3600.0",
      "availability": "event_formation",
      "imputation_strategy": "constant_zero",
      "default_imputed_value": 0.0,
      "leakage_status": "LEAKAGE_FREE"
    },
    {
      "index": 7,
      "name": "frp_zscore",
      "dtype": "float64",
      "units": "dimensionless_z_score",
      "source": "Facility Baseline Engine (180-day)",
      "formula": "(frp_max - baseline_median_frp) / (1.4826 * baseline_mad_frp)",
      "availability": "baseline_lookup",
      "imputation_strategy": "constant_zero",
      "default_imputed_value": 0.0,
      "leakage_status": "LEAKAGE_FREE"
    },
    {
      "index": 8,
      "name": "is_baseline_excursion",
      "dtype": "float64",
      "units": "binary_indicator",
      "source": "Facility Baseline Engine (180-day)",
      "formula": "1.0 if (frp_zscore > 3.0 and frp_max > 25.0) else 0.0",
      "availability": "baseline_lookup",
      "imputation_strategy": "constant_zero",
      "default_imputed_value": 0.0,
      "leakage_status": "LEAKAGE_FREE"
    },
    {
      "index": 9,
      "name": "landcover_class",
      "dtype": "float64",
      "units": "categorical_code",
      "source": "ESA WorldCover / Context (0=Water, 1=Forest, 2=Cropland, 3=Urban/Industrial, 4=Bare/Mining)",
      "formula": "raster_sample_or_context_code(event_centroid)",
      "availability": "spatial_join",
      "imputation_strategy": "mode",
      "default_imputed_value": 3.0,
      "leakage_status": "LEAKAGE_FREE"
    },
    {
      "index": 10,
      "name": "is_refinery",
      "dtype": "float64",
      "units": "binary_indicator",
      "source": "OSM / GEM Facility Metadata",
      "formula": "1.0 if (facility_type in ['refinery', 'petrochemical']) else 0.0",
      "availability": "facility_lookup",
      "imputation_strategy": "constant_zero",
      "default_imputed_value": 0.0,
      "leakage_status": "LEAKAGE_FREE"
    },
    {
      "index": 11,
      "name": "is_coal_mine",
      "dtype": "float64",
      "units": "binary_indicator",
      "source": "OSM / GEM Facility Metadata",
      "formula": "1.0 if (facility_type in ['coal_mine', 'mine']) else 0.0",
      "availability": "facility_lookup",
      "imputation_strategy": "constant_zero",
      "default_imputed_value": 0.0,
      "leakage_status": "LEAKAGE_FREE"
    },
    {
      "index": 12,
      "name": "is_power_plant",
      "dtype": "float64",
      "units": "binary_indicator",
      "source": "OSM / GEM Facility Metadata",
      "formula": "1.0 if (facility_type == 'power_plant') else 0.0",
      "availability": "facility_lookup",
      "imputation_strategy": "constant_zero",
      "default_imputed_value": 0.0,
      "leakage_status": "LEAKAGE_FREE"
    },
    {
      "index": 13,
      "name": "compactness",
      "dtype": "float64",
      "units": "dimensionless_isoperimetric_ratio",
      "source": "Event Engine Convex Hull",
      "formula": "(4.0 * pi * area_sqm) / (perimeter_m ^ 2) if perimeter_m > 0 else 1.0",
      "availability": "event_formation",
      "imputation_strategy": "median",
      "default_imputed_value": 0.5,
      "leakage_status": "LEAKAGE_FREE"
    },
    {
      "index": 14,
      "name": "persistence_ratio",
      "dtype": "float64",
      "units": "dimensionless_ratio",
      "source": "Event Engine History",
      "formula": "min(1.0, observation_count / max(1.0, duration_hours / 6.0))",
      "availability": "event_formation",
      "imputation_strategy": "constant_zero",
      "default_imputed_value": 0.0,
      "leakage_status": "LEAKAGE_FREE"
    },
    {
      "index": 15,
      "name": "spread_velocity",
      "dtype": "float64",
      "units": "km/hour",
      "source": "Event Engine Morphology Dynamics",
      "formula": "(sqrt(area_ha / 100.0)) / max(0.5, duration_hours)",
      "availability": "event_formation",
      "imputation_strategy": "constant_zero",
      "default_imputed_value": 0.0,
      "leakage_status": "LEAKAGE_FREE"
    }
  ]
}
